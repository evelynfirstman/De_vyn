{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "src/**/*",
    "components/**/*",
    "theme.ts",
    "nativewind-env.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
