# Netlify headers for the Vyn PWA (applied to the exported dist/).
# Keep the service worker + shell uncached so updates ship immediately;
# hashed bundles can be cached forever.

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_expo/*
  Cache-Control: public, max-age=31536000, immutable
