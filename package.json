{
  "name": "vyn-therapy",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:api": "npm run dev --workspace services/api",
    "build": "npm run build --workspace apps/admin",
    "build:api": "npm run build --workspace services/api",
    "typecheck": "npm run typecheck --workspace services/api",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "deploy:admin": "netlify deploy --build --prod",
    "deploy:admin:preview": "netlify deploy --build",
    "build:pwa": "npm run build:web --workspace apps/mobile",
    "deploy:pwa": "netlify deploy --dir apps/mobile/dist --prod",
    "deploy:pwa:preview": "netlify deploy --dir apps/mobile/dist",
    "build:apk": "npm run build:apk --workspace apps/mobile"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.8.0"
  },
  "overrides": {
    "react-native": "0.81.5",
    "react-native-reanimated": "4.1.1",
    "react-native-worklets": "0.5.1"
  }
}
