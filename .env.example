# Copy to .env for local runs outside Compose. Compose services use baked defaults.
# Live: Neon Postgres + Upstash Redis (paste their URLs here and into Render env vars).
DATABASE_URL=postgres://vyn:vyn@localhost:5432/vyn
REDIS_URL=redis://localhost:6379

# S3-compatible storage (S3Mock locally, Cloudflare R2 in staging/prod)
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_MEDIA_BUCKET=vyn-media
S3_PRODUCTS_BUCKET=vyn-products
# Cloudflare R2 uses region "auto".
S3_REGION=auto
# Public read base (R2 public bucket URL / custom domain). Blank falls back to endpoint+bucket.
S3_PUBLIC_BASE_URL=
# S3Mock/local needs path-style (true). R2 works with false (default).
S3_FORCE_PATH_STYLE=false

# Auth (Better Auth — wiring lands in Phase 2b)
BETTER_AUTH_SECRET=change-me

# Flutterwave (shop checkout — Phase 7; stub links until keys are set)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Set true only with real keys; webhook signature still verifies in stub mode
FLUTTERWAVE_LIVE=false
# Where Flutterwave sends the buyer after hosted checkout (must be public).
# Points at the API return page, which confirms + tells them to reopen the app.
FLUTTERWAVE_REDIRECT_URL=
# Groq AI coach (never commit real keys).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Better Auth (Phase 2b). Generate with: node -p "require('crypto').randomBytes(32).toString('base64')"
BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=http://localhost:4000

# CORS: comma-separated allowed origins (admin web + Expo PWA).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# QR signing + WooCommerce bridge (Phase 7; bridge optional until TeemDrop direct API)
QR_SECRET=change-me
WOO_URL=
WOO_CK=
WOO_CS=
# expand (ship bundle members; no kit product needed) | as-is (mirror SKUs 1:1)
WOO_BUNDLE_MODE=expand
WOO_TIMEOUT_MS=10000
# Fulfillment provider + background worker (retry sweep + tracking pull-back)
FULFILLMENT_PROVIDER=woo-bridge
FULFILLMENT_WORKER=true
FULFILLMENT_POLL_MS=60000

# Admin web
NEXT_PUBLIC_API_URL=http://localhost:4000
